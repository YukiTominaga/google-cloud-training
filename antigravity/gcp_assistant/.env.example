# ==============================================================================
# gcp_assistant 環境設定サンプルファイル (.env.example)
# 実際の利用時は、このファイルを `.env` にコピーして必要な値を設定してください。
# ※ .env ファイルは Git 管理対象外 (.gitignore) です。
# ==============================================================================

# ------------------------------------------------------------------------------
# パターン A: Vertex AI 経由（推奨: GCP プロジェクトおよび ADC 認証を利用）
# ------------------------------------------------------------------------------
# Vertex AI バックエンドを有効化
GOOGLE_GENAI_USE_VERTEXAI=True

# 操作対象の Google Cloud プロジェクト ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# 利用する Google Cloud リージョン（例: us-central1, asia-northeast1 など）
GOOGLE_CLOUD_LOCATION=us-central1

# ------------------------------------------------------------------------------
# パターン B: Google AI Studio 経由（Gemini API キーを利用）
# ------------------------------------------------------------------------------
# Vertex AI ではなく Gemini Developer API を直接利用する場合:
# GOOGLE_GENAI_USE_VERTEXAI=False
# GEMINI_API_KEY=your-gemini-api-key-here
