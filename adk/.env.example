# このファイルをコピーして、リポジトリ直下に `.env` を作成します。
#   cp .env.example .env
# ADK は各エージェントのディレクトリから親方向にたどって `.env` を探すため、
# リポジトリ直下に 1 つ置けば、すべてのサンプル (01_basic_agent など) から参照されます。
#
# 実際の API キーやプロジェクト ID はコミットしないでください (.gitignore で .env は除外済み)。

# --- 使用する Gemini モデル (全サンプル共通) ---
# 各 agent.py は os.environ.get("GEMINI_MODEL", "gemini-3.5-flash") で読み込みます。
# ここを書き換えると全サンプルのモデルを一括で差し替えられます。
GEMINI_MODEL=gemini-3.5-flash

# image_edit_studio の画像編集モデル (Nano Banana 2)。gemini-3-pro-image 等へ差し替え可能。
IMAGE_MODEL=gemini-3.1-flash-image

# どちらか一方の構成 (A または B) を選んで設定します。

# --- 構成 A: Google AI Studio の API キーを使う (手軽) ---
# https://aistudio.google.com/apikey で API キーを取得します。
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key-here

# --- 構成 B: Vertex AI (Google Cloud) を Application Default Credentials で使う ---
# 事前に `gcloud auth application-default login` を実行しておきます。
# 構成 A の 2 行をコメントアウトし、以下を有効にします。
# 注: 新しめの Gemini モデル (gemini-3.5-flash 等) は global エンドポイントを使います。
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
