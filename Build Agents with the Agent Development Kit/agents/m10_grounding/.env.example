# =====================================================================
# M10 Code 1. .env ― M1 の約束を回収する
# ---------------------------------------------------------------------
# M1 で「コードは変わらない、変わるのは .env だけ」と言った場面がここ。
# Gemini Developer API（API キー）から、Google Cloud 側の
# Gemini Enterprise Agent Platform に切り替える。
#
# 使い方：このファイルを m10_grounding/.env にコピーして値を埋める。
#   cp m10_grounding/.env.example m10_grounding/.env
#   gcloud auth application-default login   # 認証は ADC で行う
#
# adk web は agent フォルダに近い .env を優先するので、
# m10_grounding/.env を置くと M10 だけ Cloud 側に切り替わる。
#
# ⚠️ 環境変数名は GOOGLE_GENAI_USE_ENTERPRISE が正式名（2026年9月時点）。
#    スライドにある旧名 GOOGLE_GENAI_USE_VERTEXAI も動くが
#    DeprecationWarning が出る。手元で動かす段で詰まるので先に伝える。
# =====================================================================
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# 使うモデル。未設定なら各 agent.py の既定値 gemini-flash-latest
# GEMINI_MODEL=gemini-3.5-flash
