export GOOGLE_CLOUD_PROJECT=<your-project-id>
export GOOGLE_CLOUD_QUOTA_PROJECT=<your-quota-project-id>
export OTEL_RESOURCE_ATTRIBUTES=gcp.project_id=<your-project-id>,cloud.region=<your-region>,service.name=google-cloud-training,service.version=1.0.0
# cloud.region はカスタムメトリクス(OTLP)のCloud Monitoring取り込みに必須。
# 未設定または "global" を指定すると "Unrecognized region or location" /
# "location / region / zone label cannot be set to \"global\"" で400エラーになる。
# 実在するリージョン名を指定すること（例: asia-northeast1）。
