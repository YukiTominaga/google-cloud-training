# =====================================================================
# agents/.env.example
# ---------------------------------------------------------------------
# これを「agents/.env」にコピーして API キーを書き込んでください。
#   cp agents/.env.example agents/.env
#
# adk web / adk run は、agent フォルダから親フォルダへ向かって .env を
# 探しに行きます。そのため agents/.env を 1 つ置けば、m01〜m13 の
# すべての agent がこの設定を共有します（M1 Code 4 の「.env」に相当）。
# =====================================================================

GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# 使うモデル。未設定なら各 agent.py の既定値 gemini-flash-latest
# GEMINI_MODEL=gemini-3.5-flash
